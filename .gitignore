# ==========================================
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.sln.ide

# ==========================================
# NuGet
# ==========================================
.nuget/
packages/

# IMPORTANT :
# Ne pas ignorer NuGet.Config par défaut.
# Il peut contenir la configuration nécessaire à la restauration.
# S'il contient des identifiants, retire-les et utilise des secrets.

# ==========================================
# ASP.NET Core — Configuration locale / secrets
# ==========================================
appsettings.Local.json
appsettings.*.local.json
appsettings.Development.local.json
secrets.json
secrets/
.env
.env.*
!.env.example

# Certificats et clés privées locaux
*.pfx
*.p12
*.key
*.pem
!*.example.pem

# ==========================================
# EF Core — Migrations
# ==========================================
# NE PAS ignorer les migrations :
# les fichiers Migrations/*.cs doivent être versionnés.
# NE PAS ignorer les fichiers *.Designer.cs en général.

# ==========================================
# Blazor WebAssembly / PWA
# ==========================================
**/wwwroot/service-worker-assets.js
**/wwwroot/service-worker.js.map
**/wwwroot/service-worker.published.js.map

